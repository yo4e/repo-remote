{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yo4e/repo-remote/schemas/command-v1.schema.json",
  "title": "repo-remote command v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repository"],
  "properties": {
    "version": { "const": 1 },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?:[A-Za-z0-9._-]+/)?[A-Za-z0-9._-]+$"
    },
    "description": { "type": ["string", "null"], "maxLength": 350 },
    "homepage": { "type": ["string", "null"], "maxLength": 2048 },
    "topics": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
      }
    },
    "is_template": { "type": "boolean" },
    "delete_branch_on_merge": { "type": "boolean" },
    "branch_cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "const": "merged" },
        "keep": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,254}$"
          }
        },
        "confirm": { "type": "boolean" }
      }
    },
    "operation": {
      "type": "string",
      "pattern": "^wiki\\.(upsert|read|list)$"
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": { "type": "string", "minLength": 1, "maxLength": 120 },
        "content": { "type": "string", "maxLength": 50000 },
        "message": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "dry_run": { "type": "boolean" }
  },
  "anyOf": [
    { "required": ["description"] },
    { "required": ["homepage"] },
    { "required": ["topics"] },
    { "required": ["is_template"] },
    { "required": ["delete_branch_on_merge"] },
    { "required": ["branch_cleanup"] },
    { "required": ["operation", "params"] }
  ]
}
